DATABASE_URL="file:./dev.db"

# Optional comma-separated origins for reviewing the development server from other devices.
# CURIOFLOW_ALLOWED_DEV_ORIGINS=192.168.1.20

# Optional MVP entitlement caps.
# CURIOFLOW_MAX_SOURCES=500
# CURIOFLOW_MAX_PDF_UPLOAD_BYTES=52428800
# CURIOFLOW_MAX_OPML_FEEDS=100
# CURIOFLOW_ENABLE_SUMMARY_GENERATION=true
# CURIOFLOW_MONTHLY_SUMMARY_GENERATION_LIMIT=1000000000
# CURIOFLOW_MONTHLY_PODCAST_TRANSCRIPTION_LIMIT=1000000000

# Required in production before storing LLM API keys. Generate with: openssl rand -base64 32
# CURIOFLOW_SECRET_KEY=

# Password reset email via Amazon SES v2.
# CURIOFLOW_APP_URL=https://curioflow.example.com
# CURIOFLOW_PASSWORD_RESET_FROM="Curioflow <no-reply@example.com>"
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional newsletter inbox via SES receipt rules -> private S3 -> SNS -> SQS.
# Disabled unless domain, bucket, queue URL, and AWS_REGION are all set.
# CURIOFLOW_NEWSLETTER_INBOUND_DOMAIN=inbox.curioflow.net
# CURIOFLOW_NEWSLETTER_S3_BUCKET=curioflow-newsletter-inbound
# CURIOFLOW_NEWSLETTER_SQS_URL=https://sqs.us-east-1.amazonaws.com/123456789012/curioflow-newsletters
# The worker requires s3:GetObject on the inbound object prefix plus
# sqs:ReceiveMessage, sqs:DeleteMessage, and sqs:ChangeMessageVisibility.

# Optional development/test fallback that stores mock article text when extraction fails.
# Keep disabled in production so failed fetches remain visible failures.
# CURIOFLOW_ALLOW_MOCK_EXTRACTION=false

# Optional Twitter API override for tweet/article extraction checks.
# TWITTER_BEARER_TOKEN=

# Optional operational metrics publishing to InfluxDB 1.x line protocol.
# Disabled unless URL/IP, username, and password are all set.
# CURIOFLOW_INFLUXDB_IP=127.0.0.1:8086
# CURIOFLOW_INFLUXDB_URL=http://127.0.0.1:8086
# CURIOFLOW_INFLUXDB_USERNAME=
# CURIOFLOW_INFLUXDB_PASSWORD=
# CURIOFLOW_INFLUXDB_DATABASE=curioflow
# CURIOFLOW_INFLUXDB_INTERVAL_MS=60000

# Production uses the Postgres Prisma schema in prisma/postgres/schema.prisma.
# POSTGRES_PASSWORD="replace-with-a-strong-password"
# DATABASE_URL="postgresql://curioflow:password@localhost:5432/curioflow?schema=public"
